{
  "name": "Lead",
  "type": "object",
  "properties": {
    "nome_completo": {
      "type": "string",
      "description": "Nome completo do interessado ou nome da empresa"
    },
    "nome_fantasia": {
      "type": "string",
      "description": "Nome fantasia da empresa"
    },
    "telefone": {
      "type": "string",
      "description": "Telefone para contato"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email do interessado"
    },
    "cnpj": {
      "type": "string",
      "description": "CNPJ da empresa"
    },
    "tipo_estabelecimento": {
      "type": "string",
      "enum": [
        "bar",
        "restaurante",
        "lanchonete",
        "cafeteria",
        "hotel",
        "outro"
      ],
      "description": "Tipo de estabelecimento"
    },
    "segmento_detalhado": {
      "type": "string",
      "description": "Segmento de mercado detalhado (ex: Alimenta\u00e7\u00e3o/Restaurante, Hospitalidade)"
    },
    "cidade": {
      "type": "string",
      "description": "Cidade onde trabalha"
    },
    "contato": {
      "type": "string",
      "description": "Nome da pessoa de contato"
    },
    "nome_socio": {
      "type": "string",
      "description": "Nome do s\u00f3cio respons\u00e1vel"
    },
    "numero_funcionarios": {
      "type": "string",
      "enum": [
        "1-5",
        "6-10",
        "11-20",
        "21-50",
        "51+"
      ],
      "description": "Quantidade de funcion\u00e1rios (faixa)"
    },
    "qtde_empregados_exato": {
      "type": "integer",
      "description": "Quantidade exata de empregados registrados"
    },
    "porte_empresa": {
      "type": "string",
      "enum": [
        "MEI",
        "ME",
        "EPP",
        "MEDIO",
        "GRANDE"
      ],
      "description": "Porte da empresa"
    },
    "potencial_plano_saude": {
      "type": "string",
      "enum": [
        "BAIXO",
        "M\u00c9DIO",
        "ALTO",
        "MUITO_ALTO"
      ],
      "description": "Potencial para contrata\u00e7\u00e3o de plano de sa\u00fade"
    },
    "prioridade_prospeccao": {
      "type": "string",
      "enum": [
        "A - URGENTE",
        "B - ALTA",
        "C - M\u00c9DIA",
        "D - BAIXA"
      ],
      "description": "Prioridade para prospec\u00e7\u00e3o comercial"
    },
    "status": {
      "type": "string",
      "enum": [
        "Lead",
        "Qualificado",
        "Proposta",
        "Fechado",
        "Descartado"
      ],
      "default": "Lead",
      "description": "Status do lead no funil"
    },
    "corretora_id": {
      "type": "string",
      "description": "ID da corretora respons\u00e1vel"
    },
    "vendedor": {
      "type": "string",
      "description": "Vendedor respons\u00e1vel"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es adicionais"
    },
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Score de convers\u00e3o calculado por IA"
    },
    "origem_lead": {
      "type": "string",
      "enum": [
        "Site",
        "REPIS",
        "Indica\u00e7\u00e3o",
        "SINTHORESP",
        "Evento",
        "Campanha",
        "Outro"
      ],
      "default": "Site",
      "description": "Origem do lead"
    },
    "protocolo_repis": {
      "type": "string",
      "description": "N\u00famero de protocolo REPIS (se aplic\u00e1vel)"
    },
    "status_cct": {
      "type": "string",
      "description": "Status da Conven\u00e7\u00e3o Coletiva de Trabalho"
    },
    "ultima_atualizacao_score": {
      "type": "string",
      "format": "date-time",
      "description": "Data da \u00faltima atualiza\u00e7\u00e3o do score"
    }
  },
  "required": [
    "nome_completo"
  ]
}