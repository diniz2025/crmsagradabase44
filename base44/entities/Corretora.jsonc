{
  "name": "Corretora",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome da corretora"
    },
    "supervisor_nome": {
      "type": "string",
      "description": "Nome do supervisor"
    },
    "supervisor_email": {
      "type": "string",
      "format": "email",
      "description": "Email do supervisor"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "master",
        "supervisora"
      ],
      "default": "supervisora",
      "description": "Tipo de corretora"
    },
    "ativa": {
      "type": "boolean",
      "default": true,
      "description": "Se a corretora est\u00e1 ativa"
    }
  },
  "required": [
    "nome",
    "supervisor_nome",
    "supervisor_email"
  ]
}