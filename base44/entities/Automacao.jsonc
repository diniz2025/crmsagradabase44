{
  "name": "Automacao",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome da automa\u00e7\u00e3o"
    },
    "status_gatilho": {
      "type": "string",
      "enum": [
        "Lead",
        "Qualificado",
        "Proposta",
        "Fechado"
      ],
      "description": "Status que ativa a automa\u00e7\u00e3o"
    },
    "dias_apos": {
      "type": "integer",
      "description": "Dias ap\u00f3s mudan\u00e7a de status para enviar"
    },
    "tipo_mensagem": {
      "type": "string",
      "enum": [
        "email",
        "whatsapp"
      ],
      "description": "Tipo de mensagem a enviar"
    },
    "usar_script": {
      "type": "string",
      "enum": [
        "whatsapp",
        "sagrada_familia",
        "personalizado"
      ],
      "description": "Qual script usar"
    },
    "mensagem_personalizada": {
      "type": "string",
      "description": "Mensagem personalizada se n\u00e3o usar script"
    },
    "assunto_email": {
      "type": "string",
      "description": "Assunto do email (se tipo for email)"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se a automa\u00e7\u00e3o est\u00e1 ativa"
    }
  },
  "required": [
    "nome",
    "status_gatilho",
    "dias_apos",
    "tipo_mensagem",
    "usar_script"
  ]
}