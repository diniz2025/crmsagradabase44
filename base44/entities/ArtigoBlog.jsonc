{
  "name": "ArtigoBlog",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo do artigo"
    },
    "slug": {
      "type": "string",
      "description": "URL amig\u00e1vel do artigo"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "plano_saude",
        "seguro_incendio",
        "dicas_seguranca",
        "noticias",
        "rh_trabalhista",
        "gestao"
      ],
      "description": "Categoria do artigo"
    },
    "resumo": {
      "type": "string",
      "description": "Resumo curto do artigo"
    },
    "conteudo": {
      "type": "string",
      "description": "Conte\u00fado completo do artigo em markdown"
    },
    "imagem_destaque": {
      "type": "string",
      "description": "URL da imagem de destaque"
    },
    "autor": {
      "type": "string",
      "default": "Nadjair Diniz Barbosa",
      "description": "Nome do autor"
    },
    "publicado": {
      "type": "boolean",
      "default": true,
      "description": "Se o artigo est\u00e1 publicado"
    },
    "destaque": {
      "type": "boolean",
      "default": false,
      "description": "Se o artigo aparece em destaque"
    },
    "tags": {
      "type": "string",
      "description": "Tags separadas por v\u00edrgula"
    }
  },
  "required": [
    "titulo",
    "slug",
    "categoria",
    "conteudo"
  ]
}