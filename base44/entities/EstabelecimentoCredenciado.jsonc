{
  "name": "EstabelecimentoCredenciado",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome do estabelecimento"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "hospital",
        "clinica",
        "laboratorio",
        "pronto_socorro",
        "diagnostico",
        "especialidade"
      ],
      "description": "Tipo de estabelecimento"
    },
    "especialidades": {
      "type": "string",
      "description": "Especialidades oferecidas (separadas por v\u00edrgula)"
    },
    "endereco": {
      "type": "string",
      "description": "Endere\u00e7o completo"
    },
    "bairro": {
      "type": "string",
      "description": "Bairro"
    },
    "cidade": {
      "type": "string",
      "description": "Cidade"
    },
    "estado": {
      "type": "string",
      "default": "SP",
      "description": "Estado"
    },
    "cep": {
      "type": "string",
      "description": "CEP"
    },
    "telefone": {
      "type": "string",
      "description": "Telefone para contato"
    },
    "whatsapp": {
      "type": "string",
      "description": "WhatsApp"
    },
    "horario_funcionamento": {
      "type": "string",
      "description": "Hor\u00e1rio de funcionamento"
    },
    "atendimento_24h": {
      "type": "boolean",
      "default": false,
      "description": "Se atende 24 horas"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es adicionais"
    }
  },
  "required": [
    "nome",
    "tipo",
    "cidade"
  ]
}