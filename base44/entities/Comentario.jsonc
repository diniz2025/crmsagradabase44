{
  "name": "Comentario",
  "type": "object",
  "properties": {
    "artigo_id": {
      "type": "string",
      "description": "ID do artigo comentado"
    },
    "nome_autor": {
      "type": "string",
      "description": "Nome do autor do coment\u00e1rio"
    },
    "email_autor": {
      "type": "string",
      "format": "email",
      "description": "Email do autor (n\u00e3o exibido publicamente)"
    },
    "conteudo": {
      "type": "string",
      "description": "Conte\u00fado do coment\u00e1rio"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "aprovado",
        "rejeitado"
      ],
      "default": "pendente",
      "description": "Status de modera\u00e7\u00e3o do coment\u00e1rio"
    },
    "resposta_admin": {
      "type": "string",
      "description": "Resposta do administrador ao coment\u00e1rio"
    },
    "moderado_por": {
      "type": "string",
      "description": "Email do admin que moderou"
    },
    "data_moderacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data da modera\u00e7\u00e3o"
    },
    "ip_address": {
      "type": "string",
      "description": "IP do autor (para auditoria LGPD)"
    }
  },
  "required": [
    "artigo_id",
    "nome_autor",
    "email_autor",
    "conteudo"
  ]
}